[ctrl]
     xc =                        "xygjos" 
     frozen_core_postscf =       21
     basis_path =                "/home/symei/def2-TZVPP-optuna-angm" # For serial type, path in your container should be used
     auxbas_path =               "/home/symei/def2-SV(P)-JKFIT"# refer to option "bind" in "REST_Environment"
