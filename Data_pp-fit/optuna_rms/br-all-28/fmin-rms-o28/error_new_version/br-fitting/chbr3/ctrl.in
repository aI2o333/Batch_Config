[ctrl]
     xc =                        "xygjos" 
     frozen_core_postscf =       2
     basis_path =                "/home/symei/TZVPP-28-o-all" # For serial type, path in your container should be used
     auxbas_path =               "/home/symei/def2-SV(P)-JKFIT"# refer to option "bind" in "REST_Environment"
     even_tempered_basis =       false
     etb_start_atom_number =     1
     etb_beta =                  1.0
     initial_guess =             "sad"
     chkfile_type =              "hdf5"
     fchk =                      false
     pruning =                   "nwchem"
     radial_grid_method =        "treutler"
     scf_acc_rho =               1.0e-8
     scf_acc_eev =               1.0e-8
     max_scf_cycle =             250

    num_threads =           8
    charge = 0.0000  
    spin   = 1       
    spin_polarization = false

[geom]
    name = "chbr3"
    unit = "angstrom"
    position = '''
    C      -0.00000000       0.00000000       0.51920700
    H      -0.00000000       0.00000000       1.59804200
    Br       0.00000000       1.86116900      -0.04488800
    Br      -1.61182000      -0.93058500      -0.04488800
    Br       1.61182000      -0.93058500      -0.04488800
    '''
