[ctrl]
     xc =                        "b3lyp" 
     frozen_core_postscf =       21
     basis_path =                "/home/symei/def2-TZVPP-mixed" # For serial type, path in your container should be used
     auxbas_path =               "/home/symei/def2-SV(P)-JKFIT"# refer to option "bind" in "REST_Environment"
     even_tempered_basis =       false
     etb_start_atom_number =     1
     etb_beta =                  1.0
     initial_guess =             "sad"
     chkfile_type =              "hdf5"
     fchk =                      false
     pruning =                   "nwchem"
     radial_grid_method =        "treutler"
     scf_acc_rho =               1.0e-7
     scf_acc_eev =               1.0e-7
     max_scf_cycle =            400 

    num_threads =           4
    charge = 0.0000  
    spin   = 1       
    spin_polarization = false

[geom]
    name = "c=c"
    unit = "angstrom"
    position = '''
    C      -0.00000000       0.66236900       0.00000000
    H       0.92096300       1.23177500       0.00000000
    H      -0.92092000       1.23182700       0.00000000
    C      -0.00000000      -0.66236900       0.00000000
    H      -0.92096300      -1.23177500       0.00000000
    H       0.92092000      -1.23182700       0.00000000
    '''
