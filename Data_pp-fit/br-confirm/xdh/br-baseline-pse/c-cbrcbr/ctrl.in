[ctrl]
     xc =                        "xygjos" 
     frozen_core_postscf =       2
     basis_path =                "/home/symei/def2-TZVPP-ECP28MWB" # For serial type, path in your container shouldbe used
     auxbas_path =               "/home/symei/def2-SV(P)-JKFIT"# refer to option "bind" in "REST_Environment"
