#! /usr/bin/env bash

#BSUB -q small      # 替换为实际队列名（如 normal、cpu、gpu等）
#BSUB -J fit_angm         # 作业名称
#BSUB -n 4              # 申请 8 个 CPU 核心
#BSUB -R "span[ptile=16]" # 限制在单节点运行
#BSUB -o %J.out         # 输出日志文件
#BSUB -e %J.err         # 错误日志文件

export ROOT_PATH=/share/home/symei/pseudo_fitting
export FITTING_PATH=${ROOT_PATH}/DFT_Fit
export IGOR_MODULES_PATH=${ROOT_PATH}/Modules

nohup python $FITTING_PATH/DFT_Fit.py br-fitting.ctl
